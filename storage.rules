rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPrincipal() {
      return signedIn()
        && request.auth.token.email == 'sharmaravi8392@gmail.com';
    }

    function adminPath() {
      return /databases/(default)/documents/adminUsers/$(request.auth.uid);
    }

    function hasPermission(permission) {
      return isPrincipal()
        || (signedIn()
          && firestore.exists(adminPath())
          && firestore.get(adminPath()).data.active == true
          && firestore.get(adminPath()).data.verified == true
          && firestore.get(adminPath()).data.permissions[permission] == true);
    }

    function canManageCollection(collection) {
      return isPrincipal()
        || (collection == 'notices' && hasPermission('notices'))
        || (collection == 'gallery' && hasPermission('gallery'))
        || (collection == 'faculty' && hasPermission('faculty'))
        || (collection == 'syllabus' && hasPermission('syllabus'))
        || (collection == 'homepagePopups' && hasPermission('homepagePopup'))
        || (collection == 'homepage-popup' && hasPermission('homepagePopup'));
    }

    function validUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          || request.resource.contentType == 'application/pdf');
    }

    match /public/{collection}/{recordId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageCollection(collection) && validUpload();
      allow delete: if isPrincipal();
    }

    match /public/hsce/{collection}/{fileName} {
      allow read: if true;
      allow create, update: if canManageCollection(collection) && validUpload();
      allow delete: if isPrincipal();
    }

    match /public/homepage-popup/{fileName} {
      allow read: if true;
      allow create, update: if hasPermission('homepagePopup') && validUpload();
      allow delete: if isPrincipal();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
